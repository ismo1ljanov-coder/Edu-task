# Server
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edutask?schema=public"

# JWT
JWT_ACCESS_SECRET=change_this_to_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# File uploads
MAX_UPLOAD_MB=10

# So'zdon integratsiyasi (sozdon-uzb dagi EDUTASK_API_KEY bilan bir xil)
SOZDON_API_URL=https://sozdon-uzb.onrender.com
SOZDON_API_KEY=change_this_shared_secret
